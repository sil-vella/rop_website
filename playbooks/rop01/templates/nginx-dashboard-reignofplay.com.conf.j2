# Nginx configuration for dashboard.reignofplay.com
# Serves static content from /var/www/reignofplay.com/dashboard.
# /api/ is proxied to PHP backend (container rop_website_php on host port {{ dashboard_php_backend_port }}).
# SSL: uses same cert as reignofplay.com (cert includes dashboard.reignofplay.com).

# HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dashboard.reignofplay.com;

    ssl_certificate /etc/letsencrypt/live/reignofplay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reignofplay.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root {{ dashboard_root }};
    index index.html index.htm;

    access_log /var/log/nginx/dashboard.reignofplay.com.access.log;
    error_log /var/log/nginx/dashboard.reignofplay.com.error.log;

    # PHP backend (rop_website_php container, host port 8081)
    location /api/ {
        proxy_pass http://127.0.0.1:{{ dashboard_php_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name dashboard.reignofplay.com;
    return 301 https://$host$request_uri;
}
